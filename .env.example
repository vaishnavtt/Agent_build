# ==============================================================================
# AgentForge AI - Environment Configuration Example
# Copy this file to .env before starting the backend application:
#   cp .env.example .env  (or Copy-Item .env.example .env on PowerShell)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AgentForge AI"
VERSION=1.0.0

# Server Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Connection (Default: Local SQLite)
# For SQLite: sqlite:///./agentforge.db
# For PostgreSQL (future): postgresql://user:password@localhost:5432/agentforge
DATABASE_URL=sqlite:///./agentforge.db

# Google Gemini API Key (MEMBER 3 & MEMBER 5)
# Obtain a key from https://aistudio.google.com/
# NEVER commit your real API key to git.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-pro
# Optional Member 6 diagnosis model with structured output support.
GEMINI_DIAGNOSIS_MODEL=

# Workflow Execution Settings (MEMBER 5 & MEMBER 6)
DEFAULT_TIMEOUT_SECONDS=300
AUTO_REPAIR_MAX_ATTEMPTS=3

# CORS Allowed Origins (Comma-separated or list handled in backend)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

